generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  nik       String? // NIK 16 digit (data pribadi penjual)
  address   String? // alamat sesuai KTP (data pribadi penjual)
  isSeller  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store?
  orders    Order[]
}

model Store {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("Makanan")
  description  String?
  address      String?
  latitude     Float? // koordinat lokasi toko (peta / share Gmaps)
  longitude    Float?
  logoUrl      String?
  bannerUrl    String?
  qrisEnabled  Boolean  @default(false)
  qrisImageUrl String?
  qrisCode     String?
  rating       Float    @default(4.8)
  distanceKm   Float    @default(0.5)
  isOpen       Boolean  @default(true)
  openTime     String   @default("08:00")
  closeTime    String   @default("21:00")
  createdAt    DateTime @default(now())
  products     Product[]
  orders       Order[]
}

model Product {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  price         Int
  originalPrice Int?
  imageUrl      String?
  emoji         String   @default("🍽️")
  category      String   @default("Makanan")
  stock         Int      @default(50)
  sold          Int      @default(0)
  isFlashSale   Boolean  @default(false)
  createdAt     DateTime @default(now())
  orderItems    OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  items         OrderItem[]
  quantity      Int
  totalPrice    Int
  paymentMethod String   @default("TUNAI")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
}

model Payment {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway    String // "midtrans" | "demo"
  reference  String @unique // ID transaksi di gateway (unik per attempt)
  amount     Int
  status     String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED
  qrString   String? // payload QRIS mentah (audit)
  qrImageUrl String? // gambar QR (data URL / URL gateway) untuk ditampilkan
  payUrl     String? // halaman pembayaran gateway (opsional)
  paidAt     DateTime?
  expiresAt  DateTime?
  rawPayload String? // payload webhook terakhir (JSON) untuk audit
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderId])
  @@index([reference])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
  emoji     String  @default("🍽️")
  imageUrl  String?
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String // nomor tujuan (format 62xxx)
  codeHash  String // SHA-256(code + salt)
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Penyimpanan gambar (logo/banner/produk/QRIS) langsung di database —
// solusi gratis untuk Vercel (filesystem read-only). Dilayani via /api/files/[id].
model UploadedFile {
  id        String   @id @default(cuid())
  mime      String // contoh: image/webp
  size      Int // byte setelah optimasi
  data      Bytes
  createdAt DateTime @default(now())
}
