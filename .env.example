# ================================================
# JAJAN RIYEN — contoh konfigurasi .env
# Salin file ini menjadi .env lalu isi nilainya.
# Detail lengkap: lihat PANDUAN-DEPLOY.md
# ================================================

# WAJIB — koneksi database (Prisma provider: postgresql)
# Produksi: Postgres gratis dari Neon (https://neon.tech) — salin Connection String (pakai host -pooler)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Untuk `prisma db push`/migrasi, lebih stabil pakai URL direct (TANPA "-pooler")

# ---- OTP WhatsApp / SMS (isi SALAH SATU agar kode dikirim beneran) ----
# Pilihan 1: Fonnte (WhatsApp) — https://fonnte.com
FONNTE_TOKEN=
# Pilihan 2: Wablas (WhatsApp) — https://wablas.com
WABLAS_TOKEN=
WABLAS_DOMAIN=https://console.wablas.com
# Pilihan 3: Twilio (SMS) — https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# KEAMANAN OTP — teks acak panjang bebas (dipakai hashing kode verifikasi)
OTP_SALT=ganti-dengan-teks-acak-panjang

# ---- PEMBAYARAN QRIS (opsional — tanpa ini jalan dalam MODE DEMO) ----
# Midtrans (GoTo) — https://dashboard.midtrans.com (produksi) / https://dashboard.sandbox.midtrans.com (uji)
# Ambil Server Key di Settings → Access Keys. JANGAN PERNAH di-commit / dikirim ke frontend.
MIDTRANS_SERVER_KEY=
# true = produksi (api.midtrans.com); kosong/false = sandbox. Otomatis terdeteksi dari prefix SB- juga.
MIDTRANS_IS_PRODUCTION=
# Lama berlaku QRIS (menit, 1-120; default 15)
PAYMENT_EXPIRY_MINUTES=15
